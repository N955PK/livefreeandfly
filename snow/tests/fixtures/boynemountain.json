owing with holiday lights. <a href=\"https://www.boynemountain.com/skybridge-michigan\">[Click here for hours &amp; details]</a><br /><br />Keep those cold temps coming, Mother Nature.</p>\n"},{"name":"Events","title":"","background":"","text":""},{"name":"Fax Comments","title":"","background":"","text":""},{"name":"commentAlert","title":"Snow & Terrain","background":"Primary","text":""},{"name":"trailsAlert","title":"","background":"","text":""},{"name":"liftsAlert","title":"","background":"","text":""},{"name":"SkyBridge Michigan","title":"","background":"","text":""}]},"facilities":{"areas":{"area":[{"name":"Boyne Mountain","lifts":{"lift":[{"name":"Alpine","id":1,"status":"Closed","statusIcon":"closed","comment":null,"openTime":"09:00","closeTime":"16:30","nightStatus":"Closed","type":"Chairlift","capacity":2,"liftIcon":"chairlift-2","featureIcons":null,"skierWaitTime":null,"scenicWaitTime":null},{"name":"Boyneland","id":2,"status":"Closed","statusIcon":"closed","comment":null,"openTime":"11:00","closeTime":"16:30","nightStatus":"Closed","type":"Chairlift","capacity":4,"liftIcon":"chairlift-4","featureIcons":null,"skierWaitTime":null,"scenicWaitTime":null},{"name":"Disciples 8","id":3,"status":"Closed","statusIcon":"closed","comment":null,"openTime":"09:00","closeTime":"16:30","nightStatus":"Closed","type":"Detachable Chairlift","capacity":8,"liftIcon":"chairlift-8","featureIcons":["highspeed"],"skierWaitTime":null,"scenicWaitTime":null},{"name":"Hemlock","id":5,"status":"Closed","statusIcon":"closed","comment":null,"openTime":"11:00","closeTime":"18:30","nightStatus":"Closed","type":"Chairlift","capacity":2,"liftIcon":"chairlift-2","featureIcons":null,"skierWaitTime":null,"scenicWaitTime":null},{"name":"Estelle's Way","id":6,"status":"Closed","statusIcon":"closed","comment":null,"openTime":"09:00","closeTime":"16:30","nightStatus":"Closed","type":"Magic Carpet","capacity":0,"liftIcon":"magic-carpet","featureIcons":null,"skierWaitTime":null,"scenicWaitTime":null